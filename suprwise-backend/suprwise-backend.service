[Unit]
Description=Suprwise FastAPI Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/test0111/suprwise-backend
ExecStart=/usr/bin/python3 -m uvicorn suprwise.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
Environment=PYTHONPATH=/home/ubuntu/test0111/suprwise-backend

[Install]
WantedBy=multi-user.target
