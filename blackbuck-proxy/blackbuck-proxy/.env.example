# ═══════════════════════════════════════════════════════
# Suprwise — Blackbuck GPS Proxy Configuration
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your credentials
#   cp .env.example .env
# ═══════════════════════════════════════════════════════

# Your Blackbuck fleet portal credentials
BLACKBUCK_USERNAME=your_phone_or_email
BLACKBUCK_PASSWORD=your_password

# Portal URL (change if Blackbuck updates their domain)
BLACKBUCK_URL=https://fleet.blackbuck.com

# Proxy server port
PORT=3000

# How long to cache data before re-fetching (seconds)
CACHE_TTL=120

# Set to 'true' to see the browser while it scrapes (useful for debugging)
HEADLESS=true

# Anthropic log level: debug, info, warn, error
LOG_LEVEL=info
